# Local identity placeholder. Replace with authenticated account linking before deployment.
MEAL_AGENT_USER_ID=local-demo-user
APP_NAME=meal-macro-agent
HOST=127.0.0.1
PORT=8000
MAX_REPAIR_ITERATIONS=4
MAX_TOOL_CALLS=32
MAX_WALL_CLOCK_SECONDS=20
ENABLE_ORCHESTRATOR_LLM=false
WORKFLOW_DATABASE_PATH=data/meal-agent.sqlite3
SESSION_TTL_SECONDS=86400

# Optional: enables LLM routing, meal proposals, and receipt vision when true.
OLLAMA_API_KEY=
# USDA FoodData Central key; nutrition requests fall back to Open Food Facts if absent.
USDA_API_KEY=
# Enables approved mock-order simulation only; no real retailer is ever contacted.
PROCUREMENT_ENABLED=false
MAX_ORDER_BUDGET=50
MAX_DAILY_ORDER_BUDGET=100
APPROVAL_TTL_MINUTES=15

# Optional Neo4j knowledge graph (Neo4j Aura URI typically starts with neo4j+s://).
# Create the database/schema/data separately; this application only queries it.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
