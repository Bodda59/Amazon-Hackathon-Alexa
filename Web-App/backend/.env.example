# Where your MCP server is listening
MCP_URL=http://localhost:8005/mcp

# --- LLM: pick ONE provider ---
LLM_PROVIDER=anthropic          # anthropic | bedrock
MODEL_ID=claude-sonnet-5-5      # for bedrock, use a model ID / inference profile from your Bedrock console

# anthropic provider
ANTHROPIC_API_KEY=sk-ant-...

# bedrock provider (needs: pip install "anthropic[bedrock]" and AWS credentials configured)
AWS_REGION=us-east-1
